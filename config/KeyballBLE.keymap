<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>KeyballBLE.keymap</title>
<style>
  body { background: #1e1e2e; color: #cdd6f4; font-family: 'Consolas', monospace; margin: 0; padding: 16px; }
  h2 { color: #89b4fa; font-size: 15px; margin-bottom: 6px; }
  .desc { color: #a6adc8; font-size: 12px; margin-bottom: 10px; }
  .tag { display: inline-block; background: #a6e3a1; color: #1e1e2e; font-size: 11px; font-weight: bold; border-radius: 4px; padding: 2px 8px; margin-left: 8px; }
  textarea { width: 100%; height: 82vh; background: #181825; color: #cdd6f4; border: 1px solid #313244; border-radius: 8px; padding: 14px; font-family: 'Consolas', monospace; font-size: 12.5px; line-height: 1.6; resize: none; box-sizing: border-box; }
  button { background: #89b4fa; color: #1e1e2e; border: none; border-radius: 6px; padding: 8px 20px; font-size: 13px; font-weight: bold; cursor: pointer; margin-bottom: 10px; }
  button:hover { background: #74c7ec; }
</style>
</head>
<body>
<h2>KeyballBLE.keymap <span class="tag">修正済み</span></h2>
<p class="desc">テキストエリアを全選択（Ctrl+A）してコピー、またはボタンを使用してください。</p>
<button onclick="copyAll()">📋 全文コピー</button>
<textarea id="code" readonly>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        duplicate_tab: duplicate_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp L>,
                <&macro_release>,
                <&kp LCTRL>,
                <&macro_pause_for_release>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp ENTER>,
                <&macro_release>,
                <&kp LALT>;
            label = "DUPLICATE_TAB";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Keyboard {
            bindings = <
&mt RCTRL Q            &mt RCTRL W  &mt RCTRL E     &mt RCTRL R  &mt RCTRL T                                        &mt RCTRL Y  &mt RCTRL U  &mt RCTRL I          &mt RCTRL O              &mt LBKT P
&mt RCTRL A            &mt RCTRL S  &mt RCTRL D     &mt RCTRL F  &mt RCTRL G  &mo 5            &mt RCTRL DEL        &mt RCTRL H  &mt RCTRL J  &mt RCTRL K          &mt RCTRL L              &mt LS(N5) MINUS
&mt RCTRL Z            &mt RCTRL X  &mt RCTRL C     &mt RCTRL V  &mt RCTRL B  &lt 3 GRAVE      &mt RCTRL BACKSPACE  &mt RCTRL N  &mt RCTRL M  &mt LESS_THAN COMMA  &mt GREATER_THAN PERIOD  &mt LS(QUESTION) SLASH
&mt LCTRL EXCLAMATION  &lt 2 END    &kp LEFT_SHIFT  &mkp RCLK    &kp SPACE    &mkp LCLK        &mt RCTRL ENTER      &lt 1 ESC                                                               &mt LEFT_ALT TAB
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        L_JISnum {
            bindings = <
&kp LG(D)      &none  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9                                     &kp LC(HOME)  &kp UP     &kp LC(END)           &none      &kp INTERNATIONAL_1
&none          &none  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &bt BT_SEL 0        &kp DELETE     &kp LEFT      &kp DOWN   &kp RIGHT             &none      &none
&none          &none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp LEFT_SHIFT      &kp BACKSPACE  &kp LS(SEMI)  &kp MINUS  &kp LS(SINGLE_QUOTE)  &kp SLASH  &none
&kp LG(LS(S))  &none  &kp NUMBER_0  &kp F9        &kp SPACE     &kp F10             &kp LSHFT      &none                                                     &kp LS(MINUS)
            >;
            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
        };

        R_ASCnum {
            bindings = <
&none    &none  &none       &none                &none                                                         &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none  &kp LG(INT3)
&none    &none  &none       &none                &none          &bt BT_SEL 1                &kp KP_NUMBER_0    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &none  &kp LS(NUMBER_4)
&none    &none  &none       &none                &kp F9         &kp F10                     &kp DOT            &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none  &kp LS(NUMBER_5)
&kp TAB  &none  &kp K_CALC  &mt LESS_THAN SLASH  &kp LS(MINUS)  &mt GREATER_THAN COLON      &kp LS(SEMICOLON)  &kp MINUS                                                 &kp LG(D)
            >;
            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        Function {
            bindings = <
&none  &none  &none  &none      &none                                            &kp SEMI          &kp SINGLE_QUOTE  &none   &kp F9  &kp F10
&none  &none  &none  &none      &none          &duplicate_tab      &kp LG(UP)    &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &none   &none   &none
&none  &none  &none  &none      &kp LG(LS(S))  &none               &kp LG(DOWN)  &kp F1            &kp F2            &kp F3  &kp F4  &kp LG(LS(RIGHT))
&none  &none  &none  &kp LC(W)  &none          &kp LBKT            &kp LG(LEFT)  &kp LG(RIGHT)                                       &kp LG(LS(LEFT))
            >;
        };

        none {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        T_Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
</textarea>
<script>
function copyAll() {
  const ta = document.getElementById('code');
  ta.select();
  navigator.clipboard.writeText(ta.value.trim()).then(() => {
    const btn = document.querySelector('button');
    btn.textContent = '✅ コピーしました！';
    setTimeout(() => btn.textContent = '📋 全文コピー', 2000);
  });
}
</script>
</body>
</html>
