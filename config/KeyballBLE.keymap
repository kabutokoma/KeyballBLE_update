<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KeyballBLE.keymap</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Noto+Sans+JP:wght@400;600&display=swap');

  * { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg: #0f0f17;
    --surface: #161622;
    --surface2: #1c1c2e;
    --border: #2a2a40;
    --text: #c8cad8;
    --text-dim: #6b6d80;
    --accent: #6ee7b7;
    --accent2: #60a5fa;
    --accent3: #f9a8d4;
    --keyword: #c084fc;
    --string: #fbbf24;
    --comment: #4b5563;
    --include: #60a5fa;
    --define: #f472b6;
    --amp: #6ee7b7;
    --angle: #fbbf24;
    --number: #f97316;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Noto Sans JP', sans-serif;
    min-height: 100vh;
    padding: 20px;
  }

  .container {
    max-width: 960px;
    margin: 0 auto;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .title-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  h1 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 18px;
    font-weight: 700;
    color: var(--accent2);
    letter-spacing: -0.5px;
  }

  .badge {
    background: var(--accent);
    color: var(--bg);
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
    letter-spacing: 0.5px;
  }

  .desc {
    color: var(--text-dim);
    font-size: 13px;
    margin-bottom: 16px;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    gap: 8px;
  }

  button {
    font-family: 'Noto Sans JP', sans-serif;
    background: var(--surface2);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  button:hover {
    background: var(--accent2);
    color: var(--bg);
    border-color: var(--accent2);
  }

  button.copied {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .code-wrapper {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .code-header {
    background: var(--surface2);
    border-bottom: 1px solid var(--border);
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text-dim);
  }

  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .dot-r { background: #ef4444; }
  .dot-y { background: #eab308; }
  .dot-g { background: #22c55e; }

  .code-scroll {
    overflow: auto;
    max-height: 72vh;
    padding: 16px 0;
  }

  .code-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
  .code-scroll::-webkit-scrollbar-track { background: transparent; }
  .code-scroll::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

  pre {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    line-height: 1.7;
    margin: 0;
    counter-reset: line;
  }

  .line {
    display: block;
    padding: 0 20px 0 0;
    min-height: 1.7em;
    white-space: pre;
  }

  .line::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 40px;
    text-align: right;
    margin-right: 20px;
    color: var(--text-dim);
    opacity: 0.4;
    font-size: 11px;
    user-select: none;
  }

  .line:hover { background: rgba(96, 165, 250, 0.05); }

  .kw { color: var(--keyword); }
  .inc { color: var(--include); }
  .def { color: var(--define); }
  .amp { color: var(--amp); font-weight: 600; }
  .str { color: var(--string); }
  .cmt { color: var(--comment); font-style: italic; }
  .num { color: var(--number); }
  .prop { color: #93c5fd; }
  .tag { color: #a78bfa; }
</style>
</head>
<body>

<div class="container">
  <header>
    <div class="title-group">
      <h1>KeyballBLE.keymap</h1>
      <span class="badge">修正済み</span>
    </div>
    <div class="actions">
      <button id="copyBtn" onclick="copyCode()">📋 全文コピー</button>
      <button onclick="downloadFile()">💾 ダウンロード</button>
    </div>
  </header>
  <p class="desc">HTMLラッパーを除去した正しい .keymap ファイルです。<br>「全文コピー」でクリップボードにコピーし、リポジトリの <code style="color:var(--accent2)">config/KeyballBLE.keymap</code> を置き換えてください。</p>

  <div class="code-wrapper">
    <div class="code-header">
      <span class="dot dot-r"></span>
      <span class="dot dot-y"></span>
      <span class="dot dot-g"></span>
      <span style="margin-left:8px">KeyballBLE.keymap</span>
    </div>
    <div class="code-scroll">
      <pre id="codeDisplay"></pre>
    </div>
  </div>
</div>

<script>
const RAW_CODE = `#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        duplicate_tab: duplicate_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp L>,
                <&macro_release>,
                <&kp LCTRL>,
                <&macro_pause_for_release>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp ENTER>,
                <&macro_release>,
                <&kp LALT>;
            label = "DUPLICATE_TAB";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Keyboard {
            bindings = <
&mt RCTRL Q            &mt RCTRL W  &mt RCTRL E     &mt RCTRL R  &mt RCTRL T                                        &mt RCTRL Y  &mt RCTRL U  &mt RCTRL I          &mt RCTRL O              &mt LBKT P
&mt RCTRL A            &mt RCTRL S  &mt RCTRL D     &mt RCTRL F  &mt RCTRL G  &mo 5            &mt RCTRL DEL        &mt RCTRL H  &mt RCTRL J  &mt RCTRL K          &mt RCTRL L              &mt LS(N5) MINUS
&mt RCTRL Z            &mt RCTRL X  &mt RCTRL C     &mt RCTRL V  &mt RCTRL B  &lt 3 GRAVE      &mt RCTRL BACKSPACE  &mt RCTRL N  &mt RCTRL M  &mt LESS_THAN COMMA  &mt GREATER_THAN PERIOD  &mt LS(QUESTION) SLASH
&mt LCTRL EXCLAMATION  &lt 2 END    &kp LEFT_SHIFT  &mkp RCLK    &kp SPACE    &mkp LCLK        &mt RCTRL ENTER      &lt 1 ESC                                                               &mt LEFT_ALT TAB
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        L_JISnum {
            bindings = <
&kp LG(D)      &none  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9                                     &kp LC(HOME)  &kp UP     &kp LC(END)           &none      &kp INTERNATIONAL_1
&none          &none  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &bt BT_SEL 0        &kp DELETE     &kp LEFT      &kp DOWN   &kp RIGHT             &none      &none
&none          &none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp LEFT_SHIFT      &kp BACKSPACE  &kp LS(SEMI)  &kp MINUS  &kp LS(SINGLE_QUOTE)  &kp SLASH  &none
&kp LG(LS(S))  &none  &kp NUMBER_0  &kp F9        &kp SPACE     &kp F10             &kp LSHFT      &none                                                     &kp LS(MINUS)
            >;
            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
        };

        R_ASCnum {
            bindings = <
&none    &none  &none       &none                &none                                                         &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none  &kp LG(INT3)
&none    &none  &none       &none                &none          &bt BT_SEL 1                &kp KP_NUMBER_0    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &none  &kp LS(NUMBER_4)
&none    &none  &none       &none                &kp F9         &kp F10                     &kp DOT            &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none  &kp LS(NUMBER_5)
&kp TAB  &none  &kp K_CALC  &mt LESS_THAN SLASH  &kp LS(MINUS)  &mt GREATER_THAN COLON      &kp LS(SEMICOLON)  &kp MINUS                                                 &kp LG(D)
            >;
            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        Function {
            bindings = <
&none  &none  &none  &none      &none                                            &kp SEMI          &kp SINGLE_QUOTE  &none   &kp F9  &kp F10
&none  &none  &none  &none      &none          &duplicate_tab      &kp LG(UP)    &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &none   &none   &none
&none  &none  &none  &none      &kp LG(LS(S))  &none               &kp LG(DOWN)  &kp F1            &kp F2            &kp F3  &kp F4  &kp LG(LS(RIGHT))
&none  &none  &none  &kp LC(W)  &none          &kp LBKT            &kp LG(LEFT)  &kp LG(RIGHT)                                       &kp LG(LS(LEFT))
            >;
        };

        none {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        T_Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};`;

function highlight(line) {
  // Escape HTML
  let s = line.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

  // #include
  s = s.replace(/^(#include)\s+(&lt;.*?&gt;)/, '<span class="inc">$1</span> <span class="str">$2</span>');
  // #define
  s = s.replace(/^(#define)\s+(\w+)\s+(\d+)/, '<span class="def">$1</span> <span class="tag">$2</span> <span class="num">$3</span>');
  // strings
  s = s.replace(/"([^"]*)"/g, '<span class="str">"$1"</span>');
  // &references
  s = s.replace(/&amp;(\w[\w_]*)/g, '<span class="amp">&amp;$1</span>');
  // properties (word followed by = or ;)
  s = s.replace(/^(\s+)([\w-]+)(\s*=)/gm, '$1<span class="prop">$2</span>$3');
  // numbers
  s = s.replace(/\b(\d+)\b/g, '<span class="num">$1</span>');
  // keywords
  s = s.replace(/\b(compatible|bindings|key-positions|label|flavor|tapping-term-ms|quick-tap-ms|sensor-bindings)\b/g, '<span class="kw">$1</span>');

  return s;
}

function render() {
  const pre = document.getElementById('codeDisplay');
  const lines = RAW_CODE.split('\n');
  pre.innerHTML = lines.map(l => `<span class="line">${highlight(l)}</span>`).join('\n');
}

function copyCode() {
  navigator.clipboard.writeText(RAW_CODE).then(() => {
    const btn = document.getElementById('copyBtn');
    btn.classList.add('copied');
    btn.textContent = '✅ コピーしました！';
    setTimeout(() => {
      btn.classList.remove('copied');
      btn.textContent = '📋 全文コピー';
    }, 2500);
  });
}

function downloadFile() {
  const blob = new Blob([RAW_CODE], { type: 'text/plain' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'KeyballBLE.keymap';
  a.click();
  URL.revokeObjectURL(a.href);
}

render();
</script>
</body>
</html>
